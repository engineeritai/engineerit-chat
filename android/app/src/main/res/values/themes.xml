<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EngineerIt" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/theme</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>
    <style name="Theme.EngineerIt.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/Theme.EngineerIt</item>
    </style>
</resources>
